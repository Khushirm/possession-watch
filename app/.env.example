# Copy to .env. Expo bakes EXPO_PUBLIC_* values into the app bundle — never put real secrets here.

# Your computer's LAN IP (run `ipconfig`, look for IPv4 Address). Phone and computer must be on the same Wi-Fi.
# Android emulator: http://10.0.2.2:3000   iOS simulator / web: http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Optional: same value as APP_API_TOKEN in server/.env
EXPO_PUBLIC_API_TOKEN=
