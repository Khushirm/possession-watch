{
  "name": "possession-watch-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "inngest:dev": "npx --yes inngest-cli@latest dev -u http://localhost:3000/api/inngest --no-discovery",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "ISC",
  "description": "API + Inngest jobs that watch public RERA project pages for changes",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@mendable/firecrawl-js": "^4.42.1",
    "hono": "^4.13.12",
    "inngest": "^4.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
