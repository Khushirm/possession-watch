# Copy to .env and fill in. Never commit .env.

# Required for scraping. Free key: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Local development: talk to the Inngest Dev Server (no Inngest account needed).
# Remove this line in production and set INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY instead.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Optional locally, required in production. When set, every /projects request must send "Authorization: Bearer <token>".
# Use the same value as EXPO_PUBLIC_API_TOKEN in app/.env.
APP_API_TOKEN=

PORT=3000

# libSQL database URL. Locally a SQLite file; in production a Turso database (libsql://<name>-<org>.turso.io).
DATABASE_URL=file:./data/possession-watch.db
# Required only for a remote (Turso) database.
DATABASE_AUTH_TOKEN=
